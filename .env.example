# Copy to .env.local. Client variables are public in the browser bundle.
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy alternative to the publishable key:
VITE_SUPABASE_ANON_KEY=
# Required for city selection during onboarding. Restrict to your web origins.
VITE_GOOGLE_MAPS_BROWSER_KEY=
# Optional monitoring; leave empty to disable.
VITE_SENTRY_DSN=
SENTRY_DSN=
