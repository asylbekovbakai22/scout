# Copy to backend/.env. Never commit real values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
TICKETMASTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ALLOWED_ORIGINS=http://localhost:5173
ENVIRONMENT=development
# Optional shared cache and counters. Empty uses process-local memory.
REDIS_URL=
REDIS_KEY_PREFIX=scout:
GEMINI_DAILY_CALL_LIMIT=1400
AI_STREAM_HOURLY_LIMIT=10
# Optional second structured source:
SEATGEEK_CLIENT_ID=
# Empty keeps /api/cache/stats inaccessible (403).
CACHE_STATS_SECRET=
SENTRY_DSN=
# Use your own application name and contact when deploying.
NOMINATIM_USER_AGENT=Scout/1.0

# Daily Claude attempt ceiling; 0 disables, negative removes limit.
ANTHROPIC_DAILY_CALL_LIMIT=500
